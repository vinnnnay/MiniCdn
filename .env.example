# MiniCDN — environment variables
#
# Every variable below has a working default baked into the code, so MiniCDN
# runs fine with zero configuration (`docker compose up` or `./run-local.sh`
# work out of the box). Copy this file to `.env` only if you want to override
# something — e.g. change ports because they clash with something else on
# your machine, tune cache size/TTL, or point at a real remote Redis/origin.
#
#   cp .env.example .env
#
# docker-compose.yml reads `.env` automatically. Running services directly
# with plain `node dist/server.js` does NOT auto-load `.env` — export these
# yourself or use a tool like `dotenv-cli` / `dotenv -e .env -- node ...`.

# ── Redis (shared by origin + all edge nodes, for purge Pub/Sub) ──────────
# NOTE: this default (localhost) is for running services directly on your
# host (e.g. via run-local.sh). If you create a `.env` file and ALSO use
# `docker compose up`, leave REDIS_URL unset/commented there — compose
# needs the Docker service name (redis://redis:6379), which is its own
# built-in default and will otherwise get overridden by this line.
REDIS_URL=redis://localhost:6379

# ── Origin server ──────────────────────────────────────────────────────────
ORIGIN_PORT=4000
# Default Cache-Control max-age (seconds) applied to every served asset.
DEFAULT_MAX_AGE_SECONDS=30

# ── Edge nodes ──────────────────────────────────────────────────────────────
# Each edge node needs its own NODE_ID/REGION/PORT — these three examples
# match the 3-region setup in docker-compose.yml. If you run edge nodes
# directly (not via Docker), export the block for the one you're starting.
EDGE_US_PORT=4001
EDGE_US_NODE_ID=us
EDGE_US_REGION=iad
EDGE_US_SIMULATED_ORIGIN_LATENCY_MS=40

EDGE_EU_PORT=4002
EDGE_EU_NODE_ID=eu
EDGE_EU_REGION=fra
EDGE_EU_SIMULATED_ORIGIN_LATENCY_MS=70

EDGE_ASIA_PORT=4003
EDGE_ASIA_NODE_ID=asia
EDGE_ASIA_REGION=sin
EDGE_ASIA_SIMULATED_ORIGIN_LATENCY_MS=110

# Where every edge node fetches on a cache miss.
ORIGIN_URL=http://localhost:4000

# Max number of entries an edge node's LRU cache holds before evicting the
# least-recently-used item, simulating a storage-constrained edge.
MAX_CACHE_ENTRIES=200

# ── Routing layer ───────────────────────────────────────────────────────────
ROUTING_PORT=5000
# 'proxy'    = routing layer fetches from the edge and streams the response
#              back itself (default; simplest to test through one port).
# 'redirect' = routing layer issues a 302 straight to the chosen edge node,
#              closer to how a real geo-DNS/anycast CDN behaves.
ROUTING_MODE=proxy
# How often (ms) the routing layer polls each edge node's /health endpoint.
HEALTH_POLL_INTERVAL_MS=5000

# URLs the routing layer (and the shared node registry) use to reach each
# edge node. Must match wherever that edge node is actually listening.
EDGE_US_URL=http://localhost:4001
EDGE_EU_URL=http://localhost:4002
EDGE_ASIA_URL=http://localhost:4003

# ── Dashboard ────────────────────────────────────────────────────────────
# The dashboard (dashboard/src/config.ts) currently hardcodes localhost
# ports rather than reading env vars, since it runs in the browser, not
# Node. If you change ORIGIN_PORT / EDGE_*_PORT / ROUTING_PORT above,
# update dashboard/src/config.ts to match.
